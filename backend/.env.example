
# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database (MongoDB Atlas) ----
# Paste your Atlas SRV connection string here. Atlas → Database → Connect →
# Drivers → copy the string, then replace <db_username>, <db_password> and
# (optionally) add the database name after .net/, e.g.:
# mongodb+srv://myuser:mypassword@festivecook.xxxxx.mongodb.net/festivecook?retryWrites=true&w=majority
# Notes:
# - URL-encode special characters in the password (@ → %40, : → %3A, / → %2F, ? → %3F, # → %23).
# - Atlas → Network Access must allow your IP (0.0.0.0/0 for hosted platforms).
# - Local dev alternative (offline): mongodb://localhost:27017/festivecook
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/festivecook?retryWrites=true&w=majority
# Optional tuning (defaults are Atlas-friendly, change only if needed):
# MONGO_SERVER_SELECTION_TIMEOUT_MS=30000
# MONGO_MAX_POOL_SIZE=10
# MONGO_RETRY_MS=5000

# ---- Auth ----
# Use a long random string (e.g. `openssl rand -hex 32`). NEVER reuse dev values in production.
JWT_SECRET=your_jwt_secret_here

# ---- CORS / frontend origin ----
# Where the frontend is served from. Comma-separate multiple origins if needed.
# Leave empty when frontend + backend are deployed together (same origin).
# CLIENT_URL=https://your-frontend.example.com

# ---- Razorpay (live keys from https://dashboard.razorpay.com/app/keys) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_CURRENCY=INR
# Webhook secret (Dashboard → Settings → Webhooks → your endpoint secret).
# Required to verify POST /api/payments/webhook (payment.captured reconcile).
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
# Dev-only simulated checkout (NO real money). MUST be "false"/unset in production.
# ALLOW_TEST_PAYMENTS=false

# ---- Google Sign-In (from https://console.cloud.google.com/apis/credentials) ----
# Must match the frontend REACT_APP_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
