# API base URL the browser calls.
# - Single-service deployment (backend serves the build): set to https://your-domain.com/api
#   or leave the default-relative value if proxying.
# - Separate hosting (e.g. Vercel frontend + Render backend): https://your-backend.onrender.com/api
REACT_APP_API_URL=http://localhost:5000/api
# Razorpay public key (test key, safe to expose; must match backend RAZORPAY_KEY_ID)
REACT_APP_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
# Google Sign-In client ID (from https://console.cloud.google.com/apis/credentials)
# Must match the backend GOOGLE_CLIENT_ID.
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
